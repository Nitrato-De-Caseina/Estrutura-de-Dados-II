Atividade 5 — Lista de objetos
Esta atividade utiliza a estrutura definida na Atividade 4 para gerenciar múltiplos registros simultaneamente em uma lista comum.
# Reutilizamos a definição da dataclass Aluno
from dataclasses import dataclass

@dataclass
class Aluno:
    nome: str
    matricula: int
    nota1: float
    nota2: float

    def media(self) -> float:
        return (self.nota1 + self.nota2) / 2

# Cadastrando exatamente 5 alunos em uma lista
alunos = []
print("Cadastro de Alunos:")
for i in range(5):
    print(f"\n--- Cadastro do {i+1}º Aluno ---")
    nome = input("Nome: ")
    matricula = int(input("Matrícula: "))
    nota1 = float(input("Nota 1: "))
    nota2 = float(input("Nota 2: "))
    alunos.append(Aluno(nome, matricula, nota1, nota2))

# 1. Calcula e exibe a média de cada aluno cadastrado
print("\n=== MÉDIAS DOS ALUNOS ===")
for al in alunos:
    print(f"Aluno: {al.nome:<15} | Matrícula: {al.matricula:<8} | Média: {al.media():.2f}")

# 2. Filtra e exibe alunos aprovados (média >= 7.0)
print("\n=== ALUNOS APROVADOS (Média >= 7.0) ===")
aprovados = [al for al in alunos if al.media() >= 7.0]

if aprovados:
    for al in aprovados:
        print(f"✓ {al.nome} (Média: {al.media():.2f})")
else:
    print("Nenhum aluno foi aprovado.")

# 3. Identifica o aluno com a maior média de todas
aluno_destaque = max(alunos, key=lambda al: al.media())
print(f"\nEstudante com maior média: {aluno_destaque.nome} (Média: {aluno_destaque.media():.2f})")
Desafio Integrador — Sistema de Estoque
Este é o sistema completo unindo dataclasses, listas, métodos de busca dinâmica, loops contínuos e validações simples de erro para garantir a robustez do menu interativo.
from dataclasses import dataclass
from typing import List

@dataclass
class Produto:
    codigo: int
    nome: str
    preco: float
    quantidade: int

# Banco de dados temporário em memória para armazenar os produtos
estoque: List[Produto] = []

def cadastrar_produto():
    print("\n--- CADASTRO DE PRODUTO ---")
    try:
        codigo = int(input("Digite o código do produto (somente números): "))
        
        # Validação: Evitar a duplicação de códigos de produto no estoque
        if any(p.codigo == codigo for p in estoque):
            print("Erro: Já existe um produto cadastrado com esse código.")
            return
            
        nome = input("Digite o nome do produto: ")
        preco = float(input("Digite o preço unitário: R$ "))
        quantidade = int(input("Digite a quantidade inicial em estoque: "))
        
        novo_produto = Produto(codigo, nome, preco, quantidade)
        estoque.append(novo_produto)
        print(f"\nSucesso: '{nome}' cadastrado com sucesso!")
        
    except ValueError:
        print("Erro: Entrada inválida. Certifique-se de preencher dados numéricos corretamente.")

def listar_produtos():
    print("\n--- PRODUTOS EM ESTOQUE ---")
    if not estoque:
        print("Nenhum produto cadastrado no momento.")
        return
        
    for p in estoque:
        print(f"Cód: {p.codigo:<5} | Nome: {p.nome:<15} | Preço: R$ {p.preco:>7.2f} | Qtd: {p.quantidade:>4}")

def buscar_produto():
    print("\n--- BUSCAR PRODUTO ---")
    if not estoque:
        print("Nenhum produto em estoque para realizar buscas.")
        return
        
    try:
        codigo_busca = int(input("Digite o código do produto que deseja procurar: "))
        for p in estoque:
            if p.codigo == codigo_busca:
                print(f"\nProduto encontrado:")
                print(f"-> Nome: {p.nome}")
                print(f"-> Preço Unitário: R$ {p.preco:.2f}")
                print(f"-> Qtd. Disponível: {p.quantidade}")
                return
        print("Produto não localizado no estoque.")
    except ValueError:
        print("Erro: Por favor, insira apenas valores numéricos.")

def calcular_valor_total():
    print("\n--- VALOR TOTAL DO ESTOQUE ---")
    # Calcula a soma do valor unitário multiplicado pela quantidade de cada produto
    valor_total = sum(p.preco * p.quantidade for p in estoque)
    print(f"O valor total do patrimônio em estoque é: R$ {valor_total:.2f}")

def identificar_produto_mais_caro():
    print("\n--- PRODUTO MAIS CARO ---")
    if not estoque:
        print("Nenhum produto cadastrado.")
        return
        
    # Encontra o elemento com base no atributo preço
    mais_caro = max(estoque, key=lambda p: p.preco)
    print(f"Produto de maior valor unitário: {mais_caro.nome} (R$ {mais_caro.preco:.2f})")
    print(f"Quantidade física disponível em estoque: {mais_caro.quantidade} unidades")

def executar_sistema():
    while True:
        print("\n===== SISTEMA DE ESTOQUE =====")
        print("1 - Cadastrar produto")
        print("2 - Listar produtos")
        print("3 - Buscar produto")
        print("4 - Valor total do estoque")
        print("5 - Produto mais caro")
        print("0 - Sair")
        
        opcao = input("\nEscolha: ")
        
        if opcao == "1":
            cadastrar_produto()
        elif opcao == "2":
            listar_produtos()
        elif opcao == "3":
            buscar_produto()
        elif opcao == "4":
            calcular_valor_total()
        elif opcao == "5":
            identificar_produto_mais_caro()
        elif opcao == "0":
            print("\nFinalizando o Sistema de Estoque. Até mais!")
            break
        else:
            print("\nOpção inválida! Escolha uma opção válida de 0 a 5.")

# Inicializa o loop de controle do estoque
if __name__ == "__main__":
    executar_sistema()
